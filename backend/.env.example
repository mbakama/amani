# Base de donnees
DATABASE_URL=postgresql://user:password@localhost:5432/amani

# JWT
JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=7d

# Google Sign-In (OAuth 2.0 Client ID — type Web)
GOOGLE_CLIENT_ID=

# URL du frontend (liens de reset mot de passe dans les logs)
FRONTEND_URL=http://localhost:3000

# Stockage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=amani-media

PORT=3001

# Compte admin (cree/maj au demarrage si renseigne)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur Amani
